COMMERCECARE_ENVIRONMENT=development
COMMERCECARE_DATABASE_URL=postgresql+psycopg://commercecare:commercecare@db:5432/commercecare
COMMERCECARE_REDIS_URL=redis://redis:6379/0
COMMERCECARE_JWT_SECRET=replace-with-a-long-random-development-secret
COMMERCECARE_DEMO_PASSWORD=demo-password-change-me
COMMERCECARE_CORS_ORIGINS=http://localhost:3000
COMMERCECARE_SEED_ON_START=false
COMMERCECARE_STRUCTURED_PROVIDER=deterministic_mock
COMMERCECARE_STRUCTURED_PROVIDER_TIMEOUT_SECONDS=15
# Optional only: set all three to use an OpenAI-compatible structured-output endpoint.
COMMERCECARE_OPENAI_COMPATIBLE_BASE_URL=
COMMERCECARE_OPENAI_COMPATIBLE_API_KEY=
COMMERCECARE_OPENAI_COMPATIBLE_MODEL=
COMMERCECARE_COZE_WEBHOOK_SECRET=replace-with-a-long-random-coze-webhook-secret
